# Copier vers pipelines/.env pour le développement local. Ne jamais committer
# le vrai .env — voir pipelines/.gitignore et le worker (`env_file: .env`)
# dans docker-compose.yml.
#
# Toutes les valeurs secrètes sont vides ici. Un mot de passe se génère avec
# `openssl rand -hex 32` — jamais un littéral choisi à la main.

# --- Prefect (docker-compose.yml : prefect-server, worker) -----------------
# Base d'état de Prefect — jetable, sans rapport avec le catalogue EA. Elle vit
# sur le même cluster PostgreSQL que le reste (192.168.1.252), dans sa propre
# base `prefect`, jamais dans celle du catalogue.
PREFECT_DATABASE_URL=postgresql+asyncpg://prefect:<hex>@192.168.1.252:5432/prefect
# Sans ce jeton, quiconque atteint le port 4200 lit ou écrit les runs.
PREFECT_AUTH_STRING=

# --- LiteLLM (docker-compose.yml : litellm) ---------------------------------
# La variante "-database" tient son état (clés, dépenses) dans sa propre base
# PostgreSQL du même cluster, jamais celle du catalogue.
LITELLM_DATABASE_URL=postgresql://litellm:<hex>@192.168.1.252:5432/litellm
# Le jeton que le pipeline présente à LiteLLM — voir PIPELINES_LITELLM_API_KEY
# plus bas, qui doit valoir la même chose.
LITELLM_MASTER_KEY=
# Le fournisseur de l'alias "smart" de litellm.yaml.
ANTHROPIC_API_KEY=
# Le fournisseur de l'alias "fast" de litellm.yaml — LM Studio sur le cluster,
# le même serveur que celui des embeddings (voir backend/.env.example).
LM_STUDIO_API_BASE=http://192.168.1.252:1234/v1

# Chemin, sur cette machine, du certificat CA de l'infra (stack `~/OpenCode/
# Infra`) — monté en lecture seule dans le worker si renseigné. Vide, aucun
# montage n'a lieu (docker-compose.yml monte /dev/null à la place).
INFRA_CA_CERT=

# --- pipelines.settings.Settings (préfixe PIPELINES_) -----------------------
# L'API EA, jamais /mcp, jamais un repository. host.docker.internal vise le
# Mac hôte quand le pipeline tourne dans ce stack et l'API tourne via
# `make run-be` (voir docs/adr/0027).
PIPELINES_EA_BASE_URL=http://host.docker.internal:8000
PIPELINES_EA_TIMEOUT_SECONDS=30

# LiteLLM, derrière les alias "smart" et "fast" — jamais un modèle nommé ici.
PIPELINES_LITELLM_BASE_URL=http://litellm:4000
# Doit valoir la même chose que LITELLM_MASTER_KEY ci-dessus.
PIPELINES_LITELLM_API_KEY=
PIPELINES_LLM_TIMEOUT_SECONDS=300

# MinIO du stack `~/OpenCode/Infra`, en lecture seule depuis ce projet.
PIPELINES_S3_ENDPOINT=minio.famillelallier.net
PIPELINES_S3_SECURE=true
PIPELINES_S3_ACCESS_KEY=
PIPELINES_S3_SECRET_KEY=
PIPELINES_S3_BUCKET=ea-catalogue
# Le chemin *dans le conteneur* du certificat monté via INFRA_CA_CERT
# ci-dessus — laisser vide si INFRA_CA_CERT l'est aussi.
PIPELINES_S3_CA_CERT=/etc/ssl/certs/infra-ca.pem

# Budget d'un prompt, pas de la taille du document source.
PIPELINES_MAX_SOURCE_CHARS=60000

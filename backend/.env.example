# Copy to backend/.env for local development. Never commit the real .env.
EA_DEBUG=true
# Every interface, so the API is reachable from other machines on the LAN.
# What may call /mcp does NOT follow from this — see EA_MCP_ALLOWED_HOSTS below.
EA_HOST=0.0.0.0
EA_PORT=8000
# Comma-separated explicit allowlist — never "*". Since the API binds every
# interface, a browser loading the SPA from another machine sends that machine's
# origin (http://192.168.1.x:5173) and is refused until it is added here.
EA_CORS_ORIGINS=http://localhost:5173

# --- Neo4j, the store of the architecture graph (see docs/adr/0004) ---------
# The graph lives on the Docker cluster, deployed from deploy/neo4j.stack.yml
# (docs/adr/0006). Nothing starts it locally; `make db-ping` checks it answers.
#
# The password is the one set on the Portainer stack — ask whoever deployed it,
# and leave it out of every committed file. Outside EA_DEBUG the application
# refuses to start without one. `make db-shell` reads it from here too.
EA_NEO4J_URI=bolt://192.168.1.252:7687
EA_NEO4J_USER=neo4j
EA_NEO4J_PASSWORD=
EA_NEO4J_DATABASE=neo4j

# --- PostgreSQL, everything that is not the graph (docs/adr/0004, 0015) ----
# Auth, audit, scheduled work. It runs on the same Docker cluster as the graph;
# nothing starts it locally, `make pg-ping` checks it answers.
#
# No table exists yet, so the store stays shut while EA_POSTGRES_ENABLED is
# false: a machine out of reach of the cluster still boots the API. The first
# table flips it to true in the same commit.
#
# The password is a real shared secret, like the graph's above: ask whoever
# deployed it and leave it out of every committed file. `make pg-shell` and
# `make pg-migrate` read it from here too.
EA_POSTGRES_ENABLED=false
EA_POSTGRES_HOST=192.168.1.252
EA_POSTGRES_PORT=5432
EA_POSTGRES_USER=ea
EA_POSTGRES_PASSWORD=
EA_POSTGRES_DATABASE=ea

# --- The MCP adapter, served at /mcp (see docs/adr/0014) -------------------
# On by default. Until auth exists, /mcp is an unauthenticated *write* path
# onto the architecture graph for anyone who can reach this host: set it to
# false on any deployment that is not on a trusted network.
EA_MCP_ENABLED=true
# Which Host headers /mcp answers, comma-separated — never "*" (a port wildcard
# like localhost:* is fine, the host itself is still named). Deliberately NOT
# derived from EA_HOST: the SDK only turns DNS-rebinding protection on for a
# loopback host, so tying the two would disable it the moment the API binds
# 0.0.0.0. An agent on another machine is added here on purpose.
EA_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*

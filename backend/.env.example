# Copy to backend/.env for local development. Never commit the real .env.
EA_DEBUG=true
EA_HOST=127.0.0.1
EA_PORT=8000
# Comma-separated explicit allowlist — never "*".
EA_CORS_ORIGINS=http://localhost:5173

# --- Neo4j, the store of the architecture graph (see docs/adr/0004) ---------
# `make db-up` starts a container matching these values. A deployed instance
# gets its password from its own secret store: outside EA_DEBUG the application
# refuses to start without one.
EA_NEO4J_URI=bolt://localhost:7687
EA_NEO4J_USER=neo4j
EA_NEO4J_PASSWORD=developmentonly
EA_NEO4J_DATABASE=neo4j

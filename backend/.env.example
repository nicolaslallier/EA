# Copy to backend/.env for local development. Never commit the real .env.
EA_DEBUG=true
# Every interface, so the API is reachable from other machines on the LAN.
# What may call /mcp does NOT follow from this — see EA_MCP_ALLOWED_HOSTS below.
EA_HOST=0.0.0.0
EA_PORT=8000
# Comma-separated explicit allowlist — never "*". Both servers bind every
# interface, so a browser loading the SPA from another machine sends that
# machine's origin (http://192.168.1.x:5173) and is refused until it is added
# here. `make run-fe` prints the exact origin to paste. An origin is an exact
# string: no wildcard, and every host that serves the SPA needs its own entry.
EA_CORS_ORIGINS=http://localhost:5173

# --- Ce que le processus écrit dans ses logs (docs/adr/0021) ---------------
# Le niveau de NOTRE code. INFO donne le démarrage (ce qui a été ouvert, et
# où), une ligne par requête HTTP avec son identifiant et sa durée, une ligne
# par écriture dans le catalogue, et une ligne par outil appelé par un agent.
# DEBUG ajoute les traces qu'on veut quand on cherche quelque chose.
EA_LOG_LEVEL=INFO

# Texte lisible, ou un objet JSON par ligne. Laissé vide, suit EA_DEBUG :
# `make run` entremêle les deux serveurs dans un terminal et doit rester
# lisible, alors que les logs d'un déploiement sont lus par un collecteur.
# EA_LOG_JSON=false

# Une ligne par requête — méthode, chemin, statut, durée, identifiant. À true :
# la couper rend la main au log d'accès d'uvicorn, qui ne connaît ni la durée
# ni l'identifiant. /health est journalisé en DEBUG, parce qu'une sonde
# l'interroge sans fin et qu'un 200 n'y apprend rien ; ses échecs remontent.
EA_LOG_REQUESTS=true

# Les trois flux bruyants, chacun derrière son interrupteur et chacun coupé.
# Ils ne sont volontairement PAS ouverts par EA_LOG_LEVEL=DEBUG : vouloir voir
# notre raisonnement en détail n'est pas demander tout le Cypher, tout le SQL
# et tous les allers-retours HTTP à la fois. Ouvre-en un à la fois.
EA_LOG_CYPHER=false
EA_LOG_SQL=false
EA_LOG_EMBEDDINGS=false

# --- Neo4j, the store of the architecture graph (see docs/adr/0004) ---------
# The graph lives on the Docker cluster, deployed from deploy/neo4j.stack.yml
# (docs/adr/0006). Nothing starts it locally; `make db-ping` checks it answers.
#
# The password is the one set on the Portainer stack — ask whoever deployed it,
# and leave it out of every committed file. Outside EA_DEBUG the application
# refuses to start without one. `make db-shell` reads it from here too.
EA_NEO4J_URI=bolt://192.168.1.252:7687
EA_NEO4J_USER=neo4j
EA_NEO4J_PASSWORD=
EA_NEO4J_DATABASE=neo4j

# --- PostgreSQL, everything that is not the graph (docs/adr/0004, 0015) ----
# Les documents markdown attachés aux éléments (docs/adr/0017), et plus tard
# l'auth, l'audit et les traitements planifiés. Elle tourne sur le même cluster
# Docker que le graphe ; rien ne la démarre localement, `make pg-ping` vérifie
# qu'elle répond, `make pg-migrate` applique les migrations.
#
# À true depuis la première table : un déploiement sans PostgreSQL est
# désormais une erreur de configuration, et l'API le dit au démarrage plutôt
# qu'au premier envoi de fichier.
#
# The password is a real shared secret, like the graph's above: ask whoever
# deployed it and leave it out of every committed file. `make pg-shell` and
# `make pg-migrate` read it from here too.
EA_POSTGRES_ENABLED=true
EA_POSTGRES_HOST=192.168.1.252
EA_POSTGRES_PORT=5432
EA_POSTGRES_USER=ea
EA_POSTGRES_PASSWORD=
EA_POSTGRES_DATABASE=ea

# --- Embeddings, behind the document search (docs/adr/0019) ---------------
# LM Studio, sur le même cluster que les deux bases, sert un /v1/embeddings
# compatible OpenAI. Rien ne le démarre localement : `make embed-ping` vérifie
# que le modèle répond et à quelle largeur, `make embed-models` liste ce qui
# est chargé.
#
# À true par défaut, comme les deux bases : une recherche qui ne renvoie
# silencieusement rien est pire qu'une API qui refuse de démarrer. Le
# démarrage interroge le service et refuse un modèle dont les vecteurs n'ont
# pas la largeur de la colonne.
#
# La largeur (1024) n'est PAS un réglage : c'est celle de la colonne
# `document_chunks.embedding`. En changer est une migration et un
# `make docs-reindex` complet, jamais une variable d'environnement.
EA_EMBEDDINGS_ENABLED=true
EA_EMBEDDINGS_BASE_URL=http://192.168.1.252:1234/v1
EA_EMBEDDINGS_MODEL=text-embedding-mxbai-embed-large-v1
# Vide pour LM Studio, qui n'authentifie rien. Rempli si on pointe un
# fournisseur hébergé — et alors c'est un vrai secret, comme les mots de passe
# ci-dessus.
EA_EMBEDDINGS_API_KEY=
# Large : la première requête après un démarrage à froid charge le modèle.
EA_EMBEDDINGS_TIMEOUT_SECONDS=60
EA_EMBEDDINGS_BATCH_SIZE=16
# Les instructions dont ce modèle a besoin. mxbai en veut une sur la question
# et aucune sur le passage ; la famille e5 veut "passage: " et "query: " ;
# bge-m3 n'en veut aucune. Les inverser ne se voit pas et coûte du rappel.
EA_EMBEDDINGS_PASSAGE_PREFIX=
EA_EMBEDDINGS_QUERY_PREFIX=Represent this sentence for searching relevant passages: 

# --- The MCP adapter, served at /mcp (see docs/adr/0014) -------------------
# On by default. Until auth exists, /mcp is an unauthenticated *write* path
# onto the architecture graph: set it to false on a deployment that wants no
# agent-facing tools at all.
EA_MCP_ENABLED=true
# Who may call the tools: by default only a client on THIS machine — the TCP
# peer must be loopback (127.0.0.1, ::1), so Claude Code on the same Mac, as
# .mcp.json configures it, works and a script elsewhere on the LAN gets a 403
# whatever headers it sends (docs/adr/0023). true serves every machine that
# reaches the API, with no authentication. Behind a reverse proxy the peer is
# the proxy: true there serves everyone the proxy serves. Prefer an SSH tunnel
# (ssh -L 8000:127.0.0.1:8000 ...) for a remote agent until auth exists.
EA_MCP_ALLOW_REMOTE_CLIENTS=false
# Which Host headers /mcp answers, comma-separated — never "*" (a port wildcard
# like localhost:* is fine, the host itself is still named). This defends
# against DNS rebinding, i.e. a browser tricked into calling us; it does NOT
# decide who is served, since any script writes the Host it likes — that is
# EA_MCP_ALLOW_REMOTE_CLIENTS above. Deliberately NOT derived from EA_HOST: the
# SDK only turns the protection on for a loopback host, so tying the two would
# disable it the moment the API binds 0.0.0.0. A remote agent needs its Host
# here AND EA_MCP_ALLOW_REMOTE_CLIENTS=true.
EA_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*

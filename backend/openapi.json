{
  "components": {
    "schemas": {
      "AccessType": {
        "description": "How an `ACCESS` relationship touches the passive element it points at.",
        "enum": [
          "access",
          "read",
          "write",
          "read_write"
        ],
        "title": "AccessType",
        "type": "string"
      },
      "Aspect": {
        "description": "The aspect an element belongs to \u2014 the column of the ArchiMate framework.",
        "enum": [
          "active_structure",
          "behavior",
          "passive_structure",
          "motivation",
          "composite",
          "connector"
        ],
        "title": "Aspect",
        "type": "string"
      },
      "ElementCreate": {
        "additionalProperties": false,
        "description": "A new architecture element.",
        "properties": {
          "description": {
            "default": "",
            "maxLength": 2000,
            "title": "Description",
            "type": "string"
          },
          "documentation": {
            "default": "",
            "maxLength": 20000,
            "title": "Documentation",
            "type": "string"
          },
          "element_type": {
            "$ref": "#/components/schemas/ElementType"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "properties": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Free-form attributes, e.g. owner or criticality.",
            "title": "Properties",
            "type": "object"
          }
        },
        "required": [
          "element_type",
          "name"
        ],
        "title": "ElementCreate",
        "type": "object"
      },
      "ElementPage": {
        "description": "One page of the catalogue, with the total so a client can paginate.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ElementRead"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "ElementPage",
        "type": "object"
      },
      "ElementRead": {
        "description": "An element as the API exposes it, layer and aspect resolved for the caller.",
        "properties": {
          "aspect": {
            "$ref": "#/components/schemas/Aspect"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "documentation": {
            "title": "Documentation",
            "type": "string"
          },
          "element_type": {
            "$ref": "#/components/schemas/ElementType"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "layer": {
            "$ref": "#/components/schemas/Layer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "properties": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Properties",
            "type": "object"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "element_type",
          "layer",
          "aspect",
          "name",
          "description",
          "documentation",
          "properties",
          "created_at",
          "updated_at"
        ],
        "title": "ElementRead",
        "type": "object"
      },
      "ElementType": {
        "description": "Every element type ArchiMate 3.2 defines.\n\nThe member value is the wire and storage form: it appears in the OpenAPI\nschema and in the graph, so renaming one is a breaking change.",
        "enum": [
          "stakeholder",
          "driver",
          "assessment",
          "goal",
          "outcome",
          "principle",
          "requirement",
          "constraint",
          "meaning",
          "value",
          "resource",
          "capability",
          "course_of_action",
          "value_stream",
          "business_actor",
          "business_role",
          "business_collaboration",
          "business_interface",
          "business_process",
          "business_function",
          "business_interaction",
          "business_event",
          "business_service",
          "business_object",
          "contract",
          "representation",
          "product",
          "application_component",
          "application_collaboration",
          "application_interface",
          "application_function",
          "application_interaction",
          "application_process",
          "application_event",
          "application_service",
          "data_object",
          "node",
          "device",
          "system_software",
          "technology_collaboration",
          "technology_interface",
          "path",
          "communication_network",
          "technology_function",
          "technology_process",
          "technology_interaction",
          "technology_event",
          "technology_service",
          "artifact",
          "equipment",
          "facility",
          "distribution_network",
          "material",
          "work_package",
          "deliverable",
          "implementation_event",
          "plateau",
          "gap",
          "location",
          "grouping",
          "junction"
        ],
        "title": "ElementType",
        "type": "string"
      },
      "ElementTypeRead": {
        "description": "One entry of the metamodel catalogue, for building a palette in the SPA.",
        "properties": {
          "aspect": {
            "$ref": "#/components/schemas/Aspect"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "layer": {
            "$ref": "#/components/schemas/Layer"
          },
          "value": {
            "$ref": "#/components/schemas/ElementType"
          }
        },
        "required": [
          "value",
          "label",
          "layer",
          "aspect"
        ],
        "title": "ElementTypeRead",
        "type": "object"
      },
      "ElementUpdate": {
        "additionalProperties": false,
        "description": "A partial update. An omitted field keeps its stored value.\n\n`element_type` is absent on purpose: changing it could invalidate\nrelationships that already exist, which is a migration and not an edit.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "documentation": {
            "anyOf": [
              {
                "maxLength": 20000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Documentation"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "properties": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Free-form attributes, e.g. owner or criticality.",
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Properties"
          }
        },
        "title": "ElementUpdate",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "The single error envelope every failing endpoint returns.",
        "properties": {
          "detail": {
            "description": "Human-readable message, safe to display.",
            "title": "Detail",
            "type": "string"
          },
          "error": {
            "description": "Stable machine-readable code.",
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "error",
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GraphRead": {
        "description": "A sub-graph: the nodes and the edges between them, ready to be drawn.",
        "properties": {
          "elements": {
            "items": {
              "$ref": "#/components/schemas/ElementRead"
            },
            "title": "Elements",
            "type": "array"
          },
          "relationships": {
            "items": {
              "$ref": "#/components/schemas/RelationshipRead"
            },
            "title": "Relationships",
            "type": "array"
          }
        },
        "required": [
          "elements",
          "relationships"
        ],
        "title": "GraphRead",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Declared so no internal field can leak into the response.",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Layer": {
        "description": "The layers of ArchiMate 3.2, plus the cross-layer `OTHER` grouping.",
        "enum": [
          "motivation",
          "strategy",
          "business",
          "application",
          "technology",
          "physical",
          "implementation_migration",
          "other"
        ],
        "title": "Layer",
        "type": "string"
      },
      "MetamodelRead": {
        "description": "Everything a client needs to render and validate the ArchiMate palette.",
        "properties": {
          "element_types": {
            "items": {
              "$ref": "#/components/schemas/ElementTypeRead"
            },
            "title": "Element Types",
            "type": "array"
          },
          "layers": {
            "items": {
              "$ref": "#/components/schemas/Layer"
            },
            "title": "Layers",
            "type": "array"
          },
          "relationship_types": {
            "items": {
              "$ref": "#/components/schemas/RelationshipType"
            },
            "title": "Relationship Types",
            "type": "array"
          }
        },
        "required": [
          "element_types",
          "relationship_types",
          "layers"
        ],
        "title": "MetamodelRead",
        "type": "object"
      },
      "RelationshipCreate": {
        "additionalProperties": false,
        "description": "A new link between two existing elements.",
        "properties": {
          "access_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AccessType"
              },
              {
                "type": "null"
              }
            ],
            "description": "Only meaningful on an access relationship."
          },
          "directed": {
            "default": false,
            "description": "Only meaningful on an association relationship.",
            "title": "Directed",
            "type": "boolean"
          },
          "name": {
            "default": "",
            "maxLength": 200,
            "title": "Name",
            "type": "string"
          },
          "properties": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Free-form attributes, e.g. owner or criticality.",
            "title": "Properties",
            "type": "object"
          },
          "relationship_type": {
            "$ref": "#/components/schemas/RelationshipType"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          },
          "target_id": {
            "format": "uuid",
            "title": "Target Id",
            "type": "string"
          }
        },
        "required": [
          "relationship_type",
          "source_id",
          "target_id"
        ],
        "title": "RelationshipCreate",
        "type": "object"
      },
      "RelationshipRead": {
        "properties": {
          "access_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AccessType"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "directed": {
            "title": "Directed",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "properties": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Properties",
            "type": "object"
          },
          "relationship_type": {
            "$ref": "#/components/schemas/RelationshipType"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          },
          "source_type": {
            "$ref": "#/components/schemas/ElementType"
          },
          "target_id": {
            "format": "uuid",
            "title": "Target Id",
            "type": "string"
          },
          "target_type": {
            "$ref": "#/components/schemas/ElementType"
          }
        },
        "required": [
          "id",
          "relationship_type",
          "source_id",
          "target_id",
          "source_type",
          "target_type",
          "name",
          "access_type",
          "directed",
          "properties",
          "created_at"
        ],
        "title": "RelationshipRead",
        "type": "object"
      },
      "RelationshipType": {
        "description": "Every relationship type ArchiMate 3.2 defines.\n\nMembers are ordered from the strongest structural relationship to the\nweakest dependency, which is the order the specification uses when it\nderives an indirect relationship from a chain of direct ones.",
        "enum": [
          "composition",
          "aggregation",
          "assignment",
          "realization",
          "serving",
          "access",
          "influence",
          "association",
          "triggering",
          "flow",
          "specialization"
        ],
        "title": "RelationshipType",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "EA API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/elements": {
      "get": {
        "description": "Browse the catalogue, narrowed by type, by layer or by a name fragment.",
        "operationId": "list_elements_elements_get",
        "parameters": [
          {
            "in": "query",
            "name": "element_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "$ref": "#/components/schemas/ElementType"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Element Type"
            }
          },
          {
            "in": "query",
            "name": "layer",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "$ref": "#/components/schemas/Layer"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Layer"
            }
          },
          {
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Search"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ElementPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Elements",
        "tags": [
          "architecture"
        ]
      },
      "post": {
        "description": "Add an element to the catalogue.",
        "operationId": "create_element_elements_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ElementCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ElementRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Element",
        "tags": [
          "architecture"
        ]
      }
    },
    "/elements/{element_id}": {
      "delete": {
        "description": "Remove an element and every relationship attached to it.",
        "operationId": "delete_element_elements__element_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "element_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Element Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Element",
        "tags": [
          "architecture"
        ]
      },
      "get": {
        "operationId": "read_element_elements__element_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "element_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Element Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ElementRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Element",
        "tags": [
          "architecture"
        ]
      },
      "patch": {
        "description": "Change what an element says. Its type is fixed once created.",
        "operationId": "update_element_elements__element_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "element_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Element Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ElementUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ElementRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Element",
        "tags": [
          "architecture"
        ]
      }
    },
    "/elements/{element_id}/impact": {
      "get": {
        "description": "What depends on this element, transitively.\n\nEach hop is walked in the direction dependency actually runs, which is not\nalways the direction the arrow is drawn: a service serves a process, but a\nwhole is composed *of* its parts.",
        "operationId": "read_impact_elements__element_id__impact_get",
        "parameters": [
          {
            "in": "path",
            "name": "element_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Element Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "depth",
            "required": false,
            "schema": {
              "default": 5,
              "maximum": 10,
              "minimum": 1,
              "title": "Depth",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "relationship_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "$ref": "#/components/schemas/RelationshipType"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Relationship Type"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Impact",
        "tags": [
          "architecture"
        ]
      }
    },
    "/elements/{element_id}/neighbourhood": {
      "get": {
        "description": "The sub-graph around an element, following links in either direction.",
        "operationId": "read_neighbourhood_elements__element_id__neighbourhood_get",
        "parameters": [
          {
            "in": "path",
            "name": "element_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Element Id",
              "type": "string"
            }
          },
